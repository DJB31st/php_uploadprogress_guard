; configuration for php hp_multipart_guard module - do not edit here (re-asserted by Ansible and the panel hooks).
; Hosted Power: PHP's multipart/form-data parser (main/rfc1867.c) as a loadable module, so a patched
; parser can ship without rebuilding PHP (CVE-2026-109618 / 109619). Source: php/files/multipart-guard/src.
; Opt out with php_multipart_guard_enabled: false (removes this file).
extension=hp_multipart_guard.so
; parse = PHP's own multipart parser carried by the module (patched build when available)
; block = refuse every multipart/form-data request before parsing (415, empty $_POST/$_FILES): emergency mode
hp_multipart_guard.mode = {{ php_multipart_guard_mode }}
; client IPs that are always parsed, even in block mode (comma separated)
hp_multipart_guard.allow_ips = {{ php_multipart_guard_allow_ips | join(',') }}
